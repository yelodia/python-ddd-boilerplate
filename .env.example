# Application
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Storage backend: "json" (Phase 1) or "sql" (Phase 2)
STORAGE_BACKEND=json

# JSON storage (Phase 1)
JSON_DATA_DIR=data

# Database (Phase 2) — only needed when STORAGE_BACKEND=sql
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/myapp
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# Redis (arq worker)
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry
OTEL_ENABLED=false           # true in staging/production
OTEL_SERVICE_NAME=my-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
